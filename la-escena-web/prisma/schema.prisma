generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
  ARTIST
}

enum ArtistStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(CLIENT)
  slug      String?  @unique

  // Relaciones
  artistProfile ArtistProfile?
  clientAccess  ClientArtistAccess[] @relation("ClientAccess")
  artistAccess  ClientArtistAccess[] @relation("ArtistAccess")

  accounts  Account[]
  sessions  Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArtistProfile {
  id           String        @id @default(uuid())
  userId       String        @unique
  status       ArtistStatus  @default(PENDING)
  adminComment String?
  reviewedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientArtistAccess {
  id        String @id @default(uuid())
  clientId  String
  artistId  String

  client User @relation("ClientAccess", fields: [clientId], references: [id], onDelete: Cascade)
  artist User @relation("ArtistAccess", fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([clientId, artistId])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
