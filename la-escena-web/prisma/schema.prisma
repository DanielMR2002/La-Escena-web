generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CLIENT
  ARTIST
}

enum ArtistStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShortlistStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageAudience {
  ALL
  SELECTED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(CLIENT)
  slug      String?  @unique

  artistProfile ArtistProfile?
  clientAccess  ClientArtistAccess[] @relation("ClientAccess")
  artistAccess  ClientArtistAccess[] @relation("ArtistAccess")

  accounts          Account[]
  sessions          Session[]
  clientShortlists  ClientShortlist[]

  sentMessages     AdminMessage[]     @relation("MessageSender")
  receivedMessages MessageRecipient[] @relation("MessageRecipient")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArtistProfile {
  id           String        @id @default(uuid())
  userId       String        @unique
  status       ArtistStatus  @default(PENDING)
  adminComment String?
  reviewedAt   DateTime?

  sanityId    String?
  profileData Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  revisions ArtistProfileRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArtistProfileRevision {
  id           String        @id @default(uuid())
  artistId     String
  data         Json
  status       ArtistStatus  @default(PENDING)
  adminComment String?
  createdAt    DateTime      @default(now())
  reviewedAt   DateTime?

  artist ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
}

model ClientArtistAccess {
  id        String @id @default(uuid())
  clientId  String
  artistId  String

  client User @relation("ClientAccess", fields: [clientId], references: [id], onDelete: Cascade)
  artist User @relation("ArtistAccess", fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([clientId, artistId])
}

model ClientShortlist {
  id           String          @id @default(uuid())
  clientId     String
  artistIds    Json
  artistNames  Json
  message      String?
  status       ShortlistStatus @default(PENDING)
  adminComment String?
  createdAt    DateTime        @default(now())
  reviewedAt   DateTime?

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model AdminMessage {
  id        String          @id @default(uuid())
  subject   String
  body      String
  audience  MessageAudience
  sentById  String

  sentBy     User               @relation("MessageSender", fields: [sentById], references: [id])
  recipients MessageRecipient[]

  createdAt DateTime @default(now())
}

model MessageRecipient {
  id        String    @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime?

  message AdminMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  artist  User         @relation("MessageRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}